# Copy to "sdkconfig.secrets" (git-ignored) and edit. Safe placeholders only.
# After changing it: delete the generated "sdkconfig" file and rebuild, or use `idf.py menuconfig`.

# --- Wi-Fi (required) ---
CONFIG_WROOMCAM_WIFI_SSID="SchachtCam"
CONFIG_WROOMCAM_WIFI_PASSWORD="SchachtCam123"

# --- Optional static IPv4 (default is DHCP) ---
CONFIG_WROOMCAM_STATIC_IP=y
CONFIG_WROOMCAM_IP_ADDR="10.153.239.222"
CONFIG_WROOMCAM_IP_GATEWAY="10.153.239.1"
CONFIG_WROOMCAM_IP_NETMASK="255.255.255.0"
CONFIG_WROOMCAM_IP_DNS="110.153.239.1"

# --- Optional camera mode (default 320x240 @ 15 fps MJPEG) ---
# CONFIG_WROOMCAM_CAM_WIDTH=640
# CONFIG_WROOMCAM_CAM_HEIGHT=480
# CONFIG_WROOMCAM_CAM_FPS=15
