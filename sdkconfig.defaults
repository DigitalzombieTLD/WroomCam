# WroomCam defaults for ESP32-S3 USB-host MJPEG streaming.
CONFIG_IDF_TARGET="esp32s3"

# --- Module shown in the supplied photo: ESP32-S3-WROOM-1-N16R8 ---
# N16R8 uses 16 MB Quad-SPI flash and 8 MB Octal-SPI PSRAM.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# --- Speed / boot ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- PSRAM: N16R8 is Octal PSRAM. For variants without PSRAM, firmware has a low-res fallback. ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# --- USB host ---
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=3000
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y

# --- Disable unnecessary features; retain station Wi-Fi and USB host ---
# CONFIG_BT_ENABLED is not set
# CONFIG_ESP_WIFI_SOFTAP_SUPPORT is not set
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# CONFIG_UVC_PRINTF_CONFIGURATION_DESCRIPTOR is not set
CONFIG_ESP_WIFI_NVS_ENABLED=n

# --- Recovery: reboot on panic / task watchdog instead of halting ---
CONFIG_ESP_SYSTEM_PANIC_REBOOT=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
