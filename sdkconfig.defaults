# WroomCam defaults for ESP32-S3-DevKitC-1 (ESP32-S3-WROOM-1). Not verified on hardware.
CONFIG_IDF_TARGET="esp32s3"

# --- Flash: 4 MB is the smallest WROOM-1 variant (N4); raise to 8/16 MB if you like ---
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- Speed / fast boot ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- PSRAM (octal, N8R8/N16R8 style). Boot continues if no PSRAM is found.
# For quad PSRAM (e.g. R2 variants) replace the OCT lines with CONFIG_SPIRAM_MODE_QUAD=y ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# --- USB host (values taken from Espressif's UVC examples) ---
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=3000
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y

# --- Disable what we do not need ---
# CONFIG_BT_ENABLED is not set
# CONFIG_ESP_WIFI_SOFTAP_SUPPORT is not set
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# CONFIG_UVC_PRINTF_CONFIGURATION_DESCRIPTOR is not set
CONFIG_ESP_WIFI_NVS_ENABLED=n

# --- Recovery: reboot on panic / task watchdog instead of halting ---
CONFIG_ESP_SYSTEM_PANIC_REBOOT=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
